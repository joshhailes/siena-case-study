{
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/splat/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/(fonts|avatars|brand|flat|vendor)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/(home\\.css|home\\.js|splat-hero\\.js|oculus-hero\\.jpg|oculus-scene\\.jpg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
